@{
    ViewBag.Title = "Infinite Coffee";
}

<section class="hero-home">
    <div class="hero-copy">
        <p class="eyebrow">cafeteria, café e gestão integrada</p>
        <h1>INFINITE<br /><span>COFFEE</span></h1>
        <p class="hero-intro">Uma experiência integrada para cuidar de produtos, estoque, atendimentos e vendas.</p>
        <div class="hero-actions">
            <a href="/Atendimento" class="btn btn-primary btn-lg">Novo Atendimento</a>
        </div>
    </div>
    <div class="coffee-brand-art">
        <img src="~/images/logo-infinite-coffee.svg" alt="Símbolo de xícara do Infinite Coffee" />
    </div>
</section>
