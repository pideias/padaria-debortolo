@{
    ViewBag.Title = "Padaria Debortolo";
}

<section class="hero-home">
    <div class="hero-copy">
        <p class="eyebrow">paes, bolos, salgados e doces</p>
        <h1>PADARIA<br /><span>DEBORTOLO</span></h1>
        <p class="hero-intro">Tudo o que você precisa para cuidar da sua padaria, do primeiro atendimento ao último pedido.</p>
        <div class="hero-actions">
            <a href="/Atendimento" class="btn btn-primary btn-lg">Novo Atendimento</a>
        </div>
    </div>
    <div class="bakery-brand-art">
        <img src="~/images/logo-padaria.png" alt="Logotipo da Padaria Debortolo" />
    </div>
</section>

<section class="quick-menu">
    <div class="section-heading">
        <p class="eyebrow">painel da casa</p>
        <h2>O que voce quer fazer?</h2>
    </div>
    <div class="quick-grid">
        <a href="/Cliente" class="quick-card"><span class="quick-icon" aria-hidden="true">◎</span><span>Clientes</span><small>Cadastros e contatos</small></a>
        <a href="/Produto" class="quick-card"><span class="quick-icon" aria-hidden="true">◒</span><span>Cardapio</span><small>Produtos e precos</small></a>
        <a href="/Mesa" class="quick-card"><span class="quick-icon" aria-hidden="true">▱</span><span>Mesas</span><small>Disponibilidade da casa</small></a>
        <a href="/Pedido" class="quick-card"><span class="quick-icon" aria-hidden="true">☷</span><span>Pedidos Abertos</span><small>Acompanhe os atendimentos</small></a>
        <a href="/Relatorio" class="quick-card"><span class="quick-icon" aria-hidden="true">◌</span><span>Relatorios</span><small>Veja o movimento</small></a>
        <a href="/Estoque" class="quick-card"><span class="quick-icon" aria-hidden="true">▣</span><span>Estoque</span><small>Entradas, saídas e alertas</small></a>
    </div>
</section>
