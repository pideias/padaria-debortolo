@{
    ViewBag.Title = "Padaria Debortolo";
}

<section class="hero-home">
    <div class="hero-copy">
        <p class="eyebrow">paes, bolos, salgados e doces</p>
        <h1>PADARIA<br /><span>DEBORTOLO</span></h1>
        <p class="hero-intro">Tudo o que você precisa para cuidar da sua padaria, do primeiro atendimento ao último pedido.</p>
        <div class="hero-actions">
            <a href="/Atendimento" class="btn btn-primary btn-lg">Novo Atendimento</a>
        </div>
    </div>
    <div class="bakery-brand-art">
        <img src="~/images/logo-padaria.png" alt="Logotipo da Padaria Debortolo" />
    </div>
</section>
