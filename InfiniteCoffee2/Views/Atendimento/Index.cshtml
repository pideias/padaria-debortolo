@* Index.cshtml - Etapa 1: Identificacao do cliente *@
@{ ViewBag.Title = "Novo Atendimento"; }

<h2>Novo Atendimento</h2>
<p class="text-muted">Etapa 1 de 4 — Identificar Cliente</p>

@if (TempData["Mensagem"] != null)
{
    <div class="alert alert-info">@TempData["Mensagem"]</div>
}

<div class="card p-4" style="max-width: 620px;">
    <h5>Identificação do cliente</h5>
    <p class="text-muted">Informe nome e email. Se já houver cadastro, ele será localizado automaticamente.</p>
    <form method="post" action="/Atendimento/CadastrarCliente">
        <div class="mb-3">
            <label class="form-label" for="nome">Nome</label>
            <input type="text" id="nome" name="nome" class="form-control" placeholder="Seu nome" maxlength="100" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="email">Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="voce@email.com" maxlength="100" required />
        </div>
        <button type="submit" class="btn btn-primary">Continuar para escolher a mesa</button>
    </form>
</div>
